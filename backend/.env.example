# ========================================== BACKEND .ENV ==========================================

# DATABASE
NEON_DATABASE_URL=YOUR_NEON_DATABASE_CONNECTION_URL

# LLM
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OTP/CACHING
UPSTASH_REDIS_URL=YOUR_UPSTASH_REDIS_URL
UPSTASH_REDIS_TOKEN=YOUR_UPSTASH_REDIS_TOKEN

# SUPABASE RESUME BUCKET
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_KEY=YOUR_SUPABASE_API_KEY

# EMAIL
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_NAME=YOUR_BREVO_SENDER_NAME
BREVO_SENDER_EMAIL=YOUR_BREVO_SENDER_EMAIL

# JWT SECRETS
ALGORITHM=HS256
SECRET_CODE=YOUR_JWT_SECRET_CODE
ACCESS_TOKEN_EXPIRY_TIME=YOUR_ACCESS_TOKEN_EXPIRY_TIME
REFRESH_TOKEN_EXPIRY_TIME=YOUR_REFRESH_TOKEN_EXPIRY_TIME

# FRONTEND URLS
FRONTEND_URL=YOUR_FRONTEND_URL

# GOOGLE AUTH
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_REDIRECT_URL=YOUR_GOOGLE_REDIRECT_URL
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_SESSION_SECRET=YOUR_GOOGLE_SESSION_SECRET